{
    "name": "dmitryla/yii2-aws-s3-custom",
    "type": "yii2-extension",
    "description": "Custom Yii2 AWS S3 integration with configurable endpoint",
    "keywords": ["yii2", "aws", "s3", "aws-s3", "yii2-aws", "yii2-s3", "yandex", "cloud", "bucket"],
    "homepage": "https://github.com/DmitryLa/yii2-aws-s3-custom",
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitriy Larin",
            "email": "dima@h3lab.ru",
            "homepage": "https://h3lab.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/frostealth/yii2-aws-s3/issues?state=open"
    },
    "require": {
        "php": ">=7.0.0",
        "aws/aws-sdk-php": "~3.17",
        "yiisoft/yii2": "~2.0",
        "chemezov/yii2-yandex-cloud":"^3.0"
    },
    "require-dev": {
        "phpro/grumphp": "~0.8",
        "squizlabs/php_codesniffer": "~2.3"
    },
    "autoload": {
        "psr-4": {
            "dmitryla\\yii2AwsS3Custom\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
